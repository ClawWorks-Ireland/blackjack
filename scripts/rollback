#!/usr/bin/env bash
# One-step rollback (spec REQ-FLOW-4, T8). Reverts one commit on main with a
# `Rollback-of: <sha>` trailer, which main-guard accepts only if the commit is
# an exact revert (it replays it). Usable by Delmar locally and by A9
# (release.yml → Run workflow, with the Claude App token).
#
#   scripts/rollback <sha>          prepare the revert on a local main and run npm test
#   scripts/rollback <sha> --push   ...and push it to origin/main
# ROLLBACK_SKIP_TEST=1 skips the test run: only for release.yml's key-holding job, whose
# rollback-test job already ran the tests on the same revert with no key (REQ-CFG-3).
set -euo pipefail
SHA="${1:?usage: scripts/rollback <sha> [--push]}"; PUSH="${2:-}"
cd "$(git rev-parse --show-toplevel)"
[ -z "$(git status --porcelain)" ] || { echo "working tree not clean" >&2; exit 1; }
start=$(date +%s)
TOKEN="${GITHUB_TOKEN:-${GH_TOKEN:-}}"
gitnet() { if [ -n "$TOKEN" ]; then git -c "http.https://github.com/.extraheader=AUTHORIZATION: basic $(printf 'x-access-token:%s' "$TOKEN" | base64 -w0)" "$@"; else git "$@"; fi; }
gitnet fetch -q origin main
git checkout -q -B main origin/main
if [ -n "${ROLLBACK_SKIP_TEST:-}" ] && [ -z "${ROLLBACK_EXPECT_MAIN:-}" ]; then
  echo "ROLLBACK_SKIP_TEST needs ROLLBACK_EXPECT_MAIN (the main the tests ran on); not pushing an untested revert" >&2; exit 1
fi
if [ -n "${ROLLBACK_EXPECT_MAIN:-}" ] && [ "$(git rev-parse HEAD)" != "$ROLLBACK_EXPECT_MAIN" ]; then
  echo "main moved since the tests ran on ${ROLLBACK_EXPECT_MAIN:0:7}; not pushing an untested revert. Run the rollback again." >&2; exit 1
fi
FULL=$(git rev-parse --verify "$SHA^{commit}")
git merge-base --is-ancestor "$FULL" origin/main || { echo "$SHA is not on main" >&2; exit 1; }
PARENTS=$(git log -1 --format=%P "$FULL" | wc -w)
M=(); [ "$PARENTS" -gt 1 ] && M=(-m 1)
git revert --no-edit "${M[@]}" "$FULL"
git commit -q --amend -m "$(git log -1 --format=%B)

Rollback-of: $FULL"
if [ -z "${ROLLBACK_SKIP_TEST:-}" ]; then
  env -u GITHUB_TOKEN -u GH_TOKEN bash -c 'npm test' >/tmp/rollback-test.log 2>&1 || { echo "npm test fails after the revert (log: /tmp/rollback-test.log); not pushing" >&2; exit 1; }
fi
if [ "$PUSH" = --push ]; then
  if [ -n "$TOKEN" ]; then   # A9 in CI: push as clawworks-release-manager[bot]
    gitnet push "https://github.com/${GITHUB_REPOSITORY:-ClawWorks-Ireland/blackjack}.git" HEAD:main
  else
    git push origin HEAD:main  # Delmar locally (REQ-GATE-3: H's route to main)
    # The retro must not depend on the retro.yml this rollback restored: open the incident now
    # (an issue opened with Delmar's account starts the retro through its label; blackjack#46).
    if command -v gh >/dev/null; then
      gh issue create --title "Incident: rollback of ${FULL:0:7}" --label incident \
        --body "Rolled back ${FULL} on main by hand (scripts/rollback). The incident reviewer writes the retro (REQ-IMP-1)." \
        || echo "could not open the incident issue: open one labelled incident by hand" >&2
    fi
  fi
fi
echo "rolled back ${FULL:0:7} as $(git rev-parse --short HEAD) in $(( $(date +%s) - start ))s${PUSH:+ (pushed)}"
