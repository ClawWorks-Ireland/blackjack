--- a/scripts/gates/lib.js
+++ b/scripts/gates/lib.js
@@ -244,6 +244,11 @@ function guardVerdict({ sha, guardActive, pr, headStatuses = [], exactRevertOf =
   }
   if (pr) {
     if (!pr.merged_at) return { allowed: false, why: `PR #${pr.number} is not merged` };
+    // Break-glass (incident #80): when A9's path itself can't run (e.g. the gate workflows on main
+    // need runners that are down), H may merge by hand with a `Break-glass: <reason>` trailer.
+    // The trailer is the audit trail; main-guard still records the commit's status.
+    const breakGlass = !!pr.merged_by && pr.merged_by.login === OWNER && /^Break-glass: \S.*$/m.test(message);
+    if (breakGlass) return { allowed: true, why: `break-glass merge of PR #${pr.number} by ${OWNER}` };
     if (!pr.merged_by || pr.merged_by.login !== MERGE_BOT) return { allowed: false, why: `PR #${pr.number} merged by ${pr.merged_by ? pr.merged_by.login : 'unknown'}, not A9 (${MERGE_BOT})` };
     if (pr.merge_commit_sha !== sha) return { allowed: false, why: `PR #${pr.number} merge commit is ${pr.merge_commit_sha}, not ${sha}` };
     const ev = trustedStatuses(headStatuses)['merge-evidence'];
